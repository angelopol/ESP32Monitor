# ---------------------------------------------------------------------------
# Copiá este archivo a .env.local para desarrollo y cargá las mismas variables
# en Vercel (Project Settings -> Environment Variables) para producción.
# ---------------------------------------------------------------------------

# Secreto compartido con el ESP32. El firmware lo manda en cada ping.
DEVICE_TOKEN=cambia-esto-por-algo-largo-y-aleatorio

# Secreto del cron de Vercel. Vercel lo manda como "Authorization: Bearer <CRON_SECRET>"
# a /api/check automaticamente cuando esta seteado. Generá uno con: openssl rand -hex 32
CRON_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Segundos sin recibir ping para considerar que se fue la luz.
# Recomendado: >= 3x el intervalo de ping del ESP32 (ping 5s -> umbral 15s).
OFFLINE_THRESHOLD_SECONDS=15

# Zona horaria para formatear las horas en las notificaciones.
DISPLAY_TZ=America/Argentina/Buenos_Aires

# --- Upstash Redis (https://console.upstash.com -> Create Database -> REST) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Web Push / VAPID (generá con: npm run vapid) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
